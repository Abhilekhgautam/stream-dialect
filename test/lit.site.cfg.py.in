@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.circt_tools_dir = lit_config.substitute("@CIRCT_TOOLS_DIR@")
config.stream_obj_root = "@STREAM_BINARY_DIR@"
config.stream_tools_dir = "@LLVM_RUNTIME_OUTPUT_INTDIR@"
config.stream_libs_dir = "@LLVM_LIBRARY_OUTPUT_INTDIR@"
config.stream_has_plugin = @STREAM_HAS_PLUGIN@
config.llvm_shlib_ext = "@SHLIBEXT@"

import lit.llvm
lit.llvm.initialize(lit_config, config)

lit_config.load_config(config, "@STREAM_SOURCE_DIR@/test/lit.cfg.py")
